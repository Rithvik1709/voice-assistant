# Generated defaults for the open starter models. `vaani models --write-env`
# writes the same file. All values are optional except the three model paths.

# LLM: "llama" runs MODEL_PATH locally; "openai" uses an OpenAI-compatible server
LLM_BACKEND="llama"
# LLM_BASE_URL="http://localhost:11434/v1"   # Ollama
# LLM_MODEL="qwen2.5:7b"
# LLM_API_KEY=""
MODEL_PATH="models/Qwen2.5-0.5B-Instruct-Q4_K_M.gguf"
DRAFT_MODEL_PATH=""
PIPER_VOICE="models/en_US-lessac-medium.onnx"
ASR_MODEL_PATH="models/whisper-base.en"   # or a size name: base.en, small.en, small
ASR_BACKEND="whisper"         # or "vosk" (faster, live partials, less accurate)
ASR_LANGUAGE="en"

# Other languages (`vaani models --languages hi,ta --download --write-env` sets these up).
# ASR_LANGUAGE="auto" detects the language of each utterance and replies in it;
# it needs a multilingual Whisper model such as large-v3-turbo, not base.en.
# ASR_LANGUAGES="en,hi,ta"     # languages detection may choose from
# PIPER_VOICES_DIR="models/voices"   # one Piper voice per language
# TTS_FALLBACK="auto"          # no voice for a language: espeak | default | none | auto

# Audio front end
VAD_AGGRESSIVENESS=2          # 0 (lenient) .. 3 (strict)
CHUNK_MS=20                   # 10, 20 or 30
ASR_ENDPOINT_SILENCE_MS=300   # trailing silence that ends an utterance
ASR_HOLD_SILENCE_MS=1000      # allowed when the words so far end on "and", "the", "um"...

# Interruption. Without headphones or echo cancellation the assistant can hear
# itself; set ENABLE_BARGE_IN=0 to mute the mic while it speaks instead.
ENABLE_BARGE_IN=1
BARGE_IN_MS=240               # speech needed before the assistant stops talking

ACK_TONE_MS=55
ENABLE_ACK_TONE=1
VAANI_PROFILE="low_latency"
ASSISTANT_SYSTEM_PROMPT="You are Vaani, a concise voice assistant. Your replies are spoken aloud, so answer in one or two short plain sentences unless the user asks for detail, and never use markdown, lists, code blocks or emoji."
TTS_SENTENCE_MAX_TOKENS=8
TTS_EAGER_MIN_WORDS=3
PLAYER_BLOCKSIZE=128
GRPC_PORT=50051
CONVERSATION_MEMORY_PATH="data/session.jsonl"

# Live weather from open-meteo.com (sends the city name over the internet)
ENABLE_WEATHER=0
WEATHER_DEFAULT_CITY=""
WEATHER_UNITS="celsius"

# Tracing (optional, needs `pip install -e ".[otel]"`)
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
# VAANI_TRACE_CONSOLE=1
